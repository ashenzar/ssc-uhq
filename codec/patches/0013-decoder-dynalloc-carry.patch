+   /* SSC (F46): the encoder carries a large boost in band 18, 19 or 20 over to the next
+      band when that band got none and its quantised energy is high. Nothing signals
+      it; both inputs are known here. Bands from end up have no offset. */
+   if (st->ssc_mode && nbEBands == 22)
