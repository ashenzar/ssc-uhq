+#ifdef FIXED_POINT
+/* SSC (F33): Samsung's comb filter (NEON in the blob, ssc_comb_filter*_asm). Tapset 0
+   only. The overlap cross-fade uses a Q31 squared window round(2^31*w^2) of CELT's
+   window w, with Q31 tap gains, and every output sample is a single 64-bit sum rounded
+   once. Stock squares the Q15 window and truncates each tap separately. */
+static void comb_filter_const(opus_val32 *y, opus_val32 *x, int T, int N,
+      opus_val16 g10, opus_val16 g11, opus_val16 g12)
+{
+   int i;
+   for (i=0;i<N;i++)
+   {
+      opus_int64 acc = (opus_int64)g10*x[i-T]
+            + (opus_int64)g11*ADD32(x[i-T+1],x[i-T-1])
+            + (opus_int64)g12*ADD32(x[i-T+2],x[i-T-2]);
+      y[i] = x[i] + (opus_val32)((acc + (1<<14)) >> 15);
+   }
+}
+
+static const opus_val32 *ssc_win_square(int overlap)
+{
+   static opus_val32 w[256];
+   static int n;
+   int i;
+   if (n != overlap)
+   {
+      for (i=0;i<overlap;i++)
+      {
+         double s = sin(.5*M_PI*(i+.5)/overlap);
+         double v = sin(.5*M_PI*s*s);
+         w[i] = (opus_val32)MIN32(2147483647., floor(.5+2147483648.*v*v));
+      }
+      n = overlap;
+   }
+   return w;
+}
+
+void comb_filter(opus_val32 *y, opus_val32 *x, int T0, int T1, int N,
+      opus_val16 g0, opus_val16 g1, int tapset0, int tapset1,
+      const opus_val16 *window, int overlap)
+{
+   int i;
+   opus_val16 g00, g01, g02, g10, g11, g12;
+   const opus_val32 *f;
+   (void)tapset0;
+   (void)tapset1;
+   (void)window;
+   if (g0==0 && g1==0)
+   {
+      if (x!=y)
+         OPUS_MOVE(y, x, N);
+      return;
+   }
+   g00 = MULT16_16_Q15(g0, QCONST16(0.3066406250f, 15));
+   g01 = MULT16_16_Q15(g0, QCONST16(0.2170410156f, 15));
+   g02 = MULT16_16_Q15(g0, QCONST16(0.1296386719f, 15));
+   g10 = MULT16_16_Q15(g1, QCONST16(0.3066406250f, 15));
+   g11 = MULT16_16_Q15(g1, QCONST16(0.2170410156f, 15));
+   g12 = MULT16_16_Q15(g1, QCONST16(0.1296386719f, 15));
+   f = ssc_win_square(overlap);
+   for (i=0;i<overlap;i++)
+   {
+      opus_val32 f1 = f[i], f0 = 2147483647-f[i];
+      opus_int64 acc = (opus_int64)MULT16_32_Q15(g00,f0)*x[i-T0]
+            + (opus_int64)MULT16_32_Q15(g01,f0)*ADD32(x[i-T0+1],x[i-T0-1])
+            + (opus_int64)MULT16_32_Q15(g02,f0)*ADD32(x[i-T0+2],x[i-T0-2])
+            + (opus_int64)MULT16_32_Q15(g10,f1)*x[i-T1]
+            + (opus_int64)MULT16_32_Q15(g11,f1)*ADD32(x[i-T1+1],x[i-T1-1])
+            + (opus_int64)MULT16_32_Q15(g12,f1)*ADD32(x[i-T1+2],x[i-T1-2]);
+      y[i] = x[i] + (opus_val32)((acc + (1<<30)) >> 31);
+   }
+   if (g1==0)
+   {
+      if (x!=y)
+         OPUS_MOVE(y+overlap, x+overlap, N-overlap);
+      return;
+   }
+   comb_filter_const(y+i, x+i, T1, N-i, g10, g11, g12);
+}
