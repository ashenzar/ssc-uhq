+#ifdef FIXED_POINT
+/* SSC (F45): Samsung-only. If both coarse candidates are within 0.931 of maxcorr and
+   the xcorr peaks repeat with a fixed spacing from the start of the lag range to its
+   end, move best_pitch to the last two peaks of the series (the longest lags).
+   Transcribed from the blob's tone_detect (0x12088). Returns 1 if it moved them. */
+int tone_detect(const opus_val32 *xcorr, int *best_pitch, opus_val32 maxcorr,
+      int max_pitch)
+{
+   opus_val32 thr;
+   int lo, hi, d, i, j, k, step, top, r;
+   thr = (opus_val32)(((opus_int64)maxcorr*30512)>>15);
+   if (xcorr[best_pitch[0]] < thr || xcorr[best_pitch[1]] < thr)
+      return 0;
+   lo = IMIN(best_pitch[0], best_pitch[1]);
+   hi = IMAX(best_pitch[0], best_pitch[1]);
+   d = hi-lo;
+   if (xcorr[hi+1] <= xcorr[hi-1])
+      d--;
+   if (d < 5)
+      return 0;
+   /* First peak above the threshold after lo sets the spacing. */
+   for (i=2;i<d;i++)
+   {
+      opus_val32 v = xcorr[lo+i];
+      if (v > thr)
+      {
+         d = i;
+         if (v > xcorr[lo+i+1] && xcorr[lo+i-1] > xcorr[lo+i+1])
+            d--;
+         if (d < 5)
+            return 0;
+         break;
+      }
+   }
+   if (d > max_pitch>>1)
+      return 0;
+   /* Every spacing up to the end of the range must hold a peak. */
+   j = hi+d;
+   step = d;
+   while (j < max_pitch-1)
+   {
+      opus_val32 m;
+      step = d;
+      m = xcorr[j];
+      if (xcorr[j] <= xcorr[j+1])
+      {
+         step = d+1;
+         m = xcorr[j+1];
+      }
+      if (m < thr)
+         return 0;
+      j += step;
+   }
+   top = j-step;
+   /* And back down to lag 0. */
+   k = hi-d;
+   while (k >= 1)
+   {
+      opus_val32 m;
+      int left = xcorr[k] <= xcorr[k-1];
+      m = left ? xcorr[k-1] : xcorr[k];
+      k = k-d-left;
+      if (m < thr)
+         return 0;
+   }
+   r = top-d;
+   if (r < 1 || top >= max_pitch)
+      return 0;
+   if (xcorr[r] <= xcorr[r-1])
+      r--;
+   best_pitch[0] = top;
+   best_pitch[1] = r;
+   return 1;
+}
+#endif
